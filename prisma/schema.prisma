// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CollegeType {
  PUBLIC
  PRIVATE
}

enum CourseLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  DIPLOMA
}

model User {
  id                String              @id @default(cuid())
  clerkId           String              @unique
  email             String              @unique
  firstName         String?
  lastName          String?
  imageUrl          String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  reviews           Review[]
  savedColleges     SavedCollege[]
  comparisonHistory ComparisonHistory[]

  @@index([clerkId])
}

model College {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  location    String
  city        String
  state       String
  website     String?
  logoUrl     String?
  bannerUrl   String?
  type        CollegeType @default(PUBLIC)
  ranking     Int?
  established Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  courses           Course[]
  reviews           Review[]
  savedBy           SavedCollege[]
  comparisonHistory ComparisonHistory[]

  @@index([name])
  @@index([city, state])
  @@index([ranking])
}

model Course {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  duration    String
  fees        Decimal?    @db.Decimal(12, 2)
  level       CourseLevel @default(UNDERGRADUATE)
  collegeId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  college     College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([level])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  content   String?  @db.Text
  userId    String
  collegeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([collegeId])
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
}

model ComparisonHistory {
  id        String   @id @default(cuid())
  userId    String?
  collegeId String
  createdAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([collegeId])
}
